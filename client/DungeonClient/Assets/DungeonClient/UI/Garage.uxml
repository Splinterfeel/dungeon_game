<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="garage-shell">
        <ui:VisualElement class="garage-header">
            <ui:Button name="BackButton" text="← Лобби" class="back-button" />
            <ui:VisualElement class="garage-heading">
                <ui:Label name="GaragePilotLabel" text="Гараж" class="garage-title" />
                <ui:Label name="GarageProgressLabel" text="Уровень 1 · XP 0" class="garage-subtitle" />
                <ui:Label name="GarageMetricsLabel" text="" class="garage-metrics" />
            </ui:VisualElement>
            <ui:Button name="RefreshGarageButton" text="Обновить" />
        </ui:VisualElement>
        <ui:ScrollView name="GarageScroll" class="garage-scroll">
            <ui:VisualElement name="LoadoutsContainer" class="loadouts-container" />
        </ui:ScrollView>
        <ui:VisualElement class="garage-status-bar">
            <ui:Label name="GarageStatusLabel" text="Загружаем гараж…" class="garage-status" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
