.battle-shell { width: 100%; height: 100%; color: #e2edf7; font-size: 16px; }
.battle-shell Button { font-size: 16px; min-height: 30px; padding: 5px 10px; margin-right: 6px; background-color: #22394b; color: #e2edf7; }
.battle-shell Button:disabled { background-color: #17212b; color: #718393; }
.battle-shell Label { white-space: normal; }
.battle-top { position: absolute; top: 8px; left: 12px; right: 12px; flex-direction: row; align-items: center; padding: 6px; background-color: rgba(10, 16, 24, 0.9); }
.phase-label { flex-grow: 1; color: #71d6ff; }
.battle-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.actor-label { position: absolute; width: 144px; height: 50px; padding: 2px 4px; font-size: 10px; color: #ffffff; background-color: rgba(10, 16, 24, 0.85); }
.battle-shell .actor-label-name { height: 14px; -unity-text-align: middle-center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.actor-label ProgressBar { height: 14px; min-height: 14px; margin: 1px 0; }
.actor-label .unity-progress-bar__container { flex-grow: 1; }
.actor-label .unity-progress-bar__background { height: 100%; background-color: #17212b; border-width: 0; border-radius: 2px; }
.actor-label .unity-progress-bar__progress { height: 100%; border-width: 0; border-radius: 2px; }
.actor-label .unity-progress-bar__title-container { margin: 0; }
.battle-shell .actor-label .unity-progress-bar__title { margin: 0; font-size: 9px; -unity-font-style: bold; color: #ffffff; -unity-text-align: middle-center; white-space: nowrap; -unity-text-outline-width: 1px; -unity-text-outline-color: #0a1018; }
.actor-health .unity-progress-bar__progress { background-color: #29c969; }
.actor-ap .unity-progress-bar__progress { background-color: #268dff; }
.battle-shell .combat-text { position: absolute; width: 360px; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 32px; white-space: nowrap; -unity-text-outline-width: 3px; -unity-text-outline-color: #0a1018; }
.combat-damage { color: #ffd256; }
.combat-miss { color: #ffffff; }
.battle-shell .combat-error { color: #ffad79; font-size: 20px; white-space: normal; -unity-text-outline-width: 2px; }
.battle-shell .combat-skill { color: #ff7900; font-size: 24px; white-space: normal; -unity-text-outline-width: 2px; }
.battle-journal { position: absolute; top: 62px; right: 12px; width: 320px; padding: 8px; background-color: rgba(10, 16, 24, 0.85); }
.battle-journal ScrollView { max-height: 220px; }
.battle-journal Label { font-size: 13px; }
.battle-hud { position: absolute; bottom: 0; left: 0; right: 0; height: 200px; min-height: 200px; max-height: 200px; padding: 10px 14px; background-color: #0a1018; border-top-width: 2px; border-top-color: #304659; }
.hud-row { flex-direction: row; flex-grow: 1; min-height: 0; overflow: hidden; }
.actor-info { width: 49%; margin-right: 14px; }
.actor-actions { flex-grow: 1; min-width: 0; }
.actor-name { color: #71d6ff; -unity-font-style: bold; margin-bottom: 4px; }
.part-hp { font-size: 13px; color: #d5ae73; margin-top: 4px; margin-bottom: 4px; }
.actor-info Button { align-self: flex-start; }
.weapon-row, .action-row { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.weapon-button { flex-grow: 1; flex-basis: 0; white-space: normal; font-size: 13px; min-width: 140px; }
.battle-shell .weapon-button.selected { border-left-width: 3px; border-left-color: #71d6ff; background-color: #30566b; }
.battle-shell .battle-status { height: 18px; flex-shrink: 0; margin-top: 5px; color: #d5ae73; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.battle-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0, 0, 0, 0.6); }
.overlay-card { width: 650px; max-height: 85%; padding: 24px; background-color: #101e2b; border-left-width: 3px; border-left-color: #71d6ff; }
.details-scroll { height: 340px; margin-top: 12px; margin-bottom: 12px; }
.detail-part { margin-bottom: 8px; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: #304659; }
.detail-part-heading { flex-direction: row; align-items: center; }
.detail-part-name { flex-grow: 1; flex-basis: 0; margin-right: 12px; color: #e2edf7; -unity-font-style: bold; }
.detail-part-stats { margin-top: 3px; font-size: 12px; color: #9bb0c1; }
.part-health { width: 170px; height: 18px; min-height: 18px; flex-shrink: 0; }
.part-health .unity-progress-bar__container { flex-grow: 1; }
.part-health .unity-progress-bar__background { height: 100%; background-color: #17212b; border-width: 0; border-radius: 2px; }
.part-health .unity-progress-bar__progress { height: 100%; background-color: #ef4343; border-width: 0; border-radius: 2px; }
.part-health .unity-progress-bar__title-container { margin: 0; }
.battle-shell .part-health .unity-progress-bar__title { margin: 0; font-size: 11px; -unity-font-style: bold; color: #ffffff; -unity-text-align: middle-center; white-space: nowrap; -unity-text-outline-width: 1px; -unity-text-outline-color: #0a1018; }
.detail-description { margin-top: 8px; }
.result-title { font-size: 30px; color: #71d6ff; margin-bottom: 14px; }
.result-card .action-row { margin-top: 20px; }
