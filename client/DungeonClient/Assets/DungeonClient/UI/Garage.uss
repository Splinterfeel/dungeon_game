.garage-shell {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 24px;
    background-color: #0a1018;
    color: #e2edf7;
}

.garage-header {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.garage-heading {
    flex-grow: 1;
    margin-left: 14px;
    margin-right: 14px;
}

.garage-title {
    color: #71d6ff;
    font-size: 24px;
    -unity-font-style: bold;
}

.garage-subtitle,
.garage-metrics,
.muted {
    color: #92a9bd;
}

.garage-metrics {
    margin-top: 3px;
}

.garage-scroll {
    flex-grow: 1;
    min-height: 0;
}

.section-title {
    margin-top: 8px;
    margin-bottom: 8px;
    color: #71d6ff;
    font-size: 18px;
    -unity-font-style: bold;
}

.loadouts-container {
    min-width: 0;
}

.loadout-tabs,
.mode-buttons,
.slot-buttons {
    flex-direction: row;
    flex-wrap: wrap;
}

.loadout-tabs > Button,
.mode-buttons > Button,
.slot-buttons > Button {
    margin-right: 6px;
    margin-bottom: 6px;
}

.loadout-tabs {
    margin-bottom: 10px;
}

.loadout-tab,
.mode-button,
.slot-button,
.part-action,
.primary-action {
    border-radius: 3px;
}

.loadout-tab.is-selected,
.mode-button.is-selected,
.slot-button.is-selected {
    background-color: #25637b;
    color: #f1fbff;
}

.tuning-controls {
    margin-top: 6px;
    margin-bottom: 10px;
}

.mode-control,
.slot-selector {
    margin-top: 7px;
}

.mode-label,
.part-slot-title,
.filter-title {
    color: #d5ae73;
    -unity-font-style: bold;
}

.mode-effect {
    margin-top: 3px;
    color: #92a9bd;
}

.slot-selector {
    margin-bottom: 8px;
}

.loadout-card {
    min-width: 0;
    margin-bottom: 12px;
    padding: 16px;
    background-color: #14202c;
    border-left-width: 2px;
    border-left-color: #d58f38;
}

.loadout-title {
    margin-bottom: 6px;
    font-size: 18px;
    -unity-font-style: bold;
}

.stats {
    margin-top: 10px;
    color: #dbe8f2;
    white-space: normal;
}

.weight {
    margin-top: 5px;
    color: #d5ae73;
}

.subsection-title {
    margin-top: 12px;
    margin-bottom: 5px;
    color: #71d6ff;
    -unity-font-style: bold;
}

.item-row,
.muted,
.empty-state {
    white-space: normal;
}

.item-row {
    margin-top: 3px;
    color: #c6d5e2;
}

.installed-part {
    margin-top: 5px;
    padding-top: 5px;
    border-top-width: 1px;
    border-top-color: #304659;
}

.empty-state {
    color: #7890a4;
    -unity-font-style: italic;
}

.secondary-grid {
    flex-direction: row;
    min-width: 0;
    align-items: flex-start;
}

.secondary-panel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 360px;
    margin-right: 12px;
    margin-bottom: 12px;
    padding: 14px;
    background-color: #101a24;
}

.stored-part,
.skill-row {
    margin-bottom: 8px;
    padding: 8px;
    background-color: #182635;
}

.stored-part.is-selected,
.skill-row.is-selected {
    border-left-width: 2px;
    border-left-color: #71d6ff;
}

.comparison-panel {
    margin-bottom: 10px;
    padding: 8px 0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: #d58f38;
    border-bottom-color: #d58f38;
}

.comparison-row {
    margin-top: 2px;
    color: #c6d5e2;
}

.part-action,
.primary-action {
    align-self: flex-start;
    margin-top: 7px;
}

.part-actions {
    flex-direction: row;
}

.part-actions > Button {
    margin-right: 6px;
}

.primary-action {
    background-color: #25637b;
    color: #f1fbff;
}

.item-title {
    -unity-font-style: bold;
}

.garage-status-bar {
    flex-shrink: 0;
    min-height: 34px;
    margin-top: 10px;
    padding: 7px 10px;
    background-color: #101a24;
    border-left-width: 2px;
    border-left-color: #304659;
}

.garage-status {
    color: #92a9bd;
    white-space: normal;
}
