<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="LobbyShell" class="lobby-shell" style="display: none;">
    <ui:Label text="ЛОББИ" class="lobby-title" />
    <ui:Label name="LobbyPilot" />
    <ui:VisualElement name="LobbyListPanel">
      <ui:VisualElement class="lobby-actions">
        <ui:Button name="RefreshLobbies" text="Обновить" />
        <ui:Button name="LobbyGarage" text="Гараж" />
        <ui:Button name="LobbyBack" text="Сменить пилота" />
      </ui:VisualElement>
      <ui:VisualElement class="lobby-columns">
      <ui:VisualElement class="lobby-browser">
      <ui:ScrollView name="LobbyRows" class="lobby-rows" />
      <ui:VisualElement class="lobby-actions">
        <ui:DropdownField name="LobbyTeam" label="Вступить в" />
        <ui:Button name="JoinLobby" text="Присоединиться" />
      </ui:VisualElement>
      </ui:VisualElement>
      <ui:VisualElement class="lobby-card">
        <ui:Label text="Новая комната · 2 пилота · по 2 меха" />
        <ui:TextField name="LobbyName" label="Название" max-length="100" />
        <ui:Toggle name="VsBot" label="Против бота" />
        <ui:Label text="Карта: map_2 · Два нейтральных врага в обоих режимах" />
        <ui:Button name="CreateLobby" text="Создать и войти" />
      </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="LobbyRoomPanel" style="display: none;">
      <ui:Label name="RoomTitle" class="lobby-title" />
      <ui:Label name="RoomTeams" class="lobby-card room-teams" />
      <ui:Label text="Сборки берутся из гаража при старте. Для редактирования выйди из комнаты." />
      <ui:VisualElement class="lobby-actions">
        <ui:Button name="StartLobby" text="Начать матч" />
        <ui:Button name="LeaveLobby" text="Выйти из лобби" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button name="ReconnectLobby" text="Подключиться повторно" />
    <ui:Label name="LobbyStatus" class="lobby-status" />
  </ui:VisualElement>
</ui:UXML>
