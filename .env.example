# Скопируйте в .env и при необходимости замените пароль.
POSTGRES_DB=dungeon_game
POSTGRES_USER=dungeon_game
POSTGRES_PASSWORD=dungeon_game_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dungeon_game:dungeon_game_dev@localhost:5432/dungeon_game

# Для Unity CLI в автономном/агентском режиме. Значения указываются только в .env.
UNITY_SERVICE_ACCOUNT_ID=
UNITY_SERVICE_ACCOUNT_SECRET=
